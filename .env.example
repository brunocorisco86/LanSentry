# ==========================================
# 14_LanSentry - Variáveis de Ambiente
# ==========================================

# Fuso Horário
TZ=America/Sao_Paulo

# Configurações do PostgreSQL
POSTGRES_DB=lansentry
POSTGRES_USER=lansentry
POSTGRES_PASSWORD=lansentry_pass_mude_aqui
POSTGRES_PORT=5434

# Interface de Rede para varredura ARP
IFACES=eth0

# Portas Web
WYL_PORT=8840
WYL_INTERNAL_PORT=8841

# IP ou Hostname do Servidor para os links do ntfy (ex: 192.168.1.7)
SERVER_HOST=192.168.1.7

# Caminho para o banco do Pi-hole (gravity.db)
PIHOLE_GRAVITY_DB=/etc/pihole/gravity.db

# Intervalo de verificação do Sidecar (em segundos)
CHECK_INTERVAL_SECONDS=30

# Notificações Push via ntfy
NTFY_TOPIC=bruno-casa-dallas
SHOUTRRR_URL=ntfy://ntfy.sh/bruno-casa-dallas

# Servidor DNS local (Pi-hole + Unbound em 192.168.1.7 ou 127.0.0.1)
DNS_SERVER=192.168.1.7
