# ==========================================
# 14_LanSentry - Variáveis de Ambiente
# ==========================================

# Fuso Horário
TZ=America/Sao_Paulo

# Configurações do PostgreSQL
POSTGRES_DB=lansentry
POSTGRES_USER=lansentry
POSTGRES_PASSWORD=lansentry_pass_mude_aqui
POSTGRES_PORT=5432

# Interface de Rede para varredura ARP
# (No Pop!_OS pode ser enp... ou wlo1; no Alpine do Raspberry Pi costuma ser eth0)
IFACES=eth0

# Porta do WatchYourLAN Web UI
WYL_PORT=8840

# Caminho para o banco do Pi-hole (gravity.db)
# No Raspberry Pi: /etc/pihole/gravity.db
PIHOLE_GRAVITY_DB=/etc/pihole/gravity.db

# Intervalo de verificação do Sidecar de bloqueio (em segundos)
CHECK_INTERVAL_SECONDS=60
